+static bool audio_frame_matches_ao(struct ao *ao, struct mp_aframe *frame,
+                                   uint8_t **data)
+{
+    if (!data || mp_aframe_get_format(frame) != ao->format ||
+        mp_aframe_get_rate(frame) != ao->samplerate ||
+        mp_aframe_get_planes(frame) != ao->num_planes ||
+        mp_aframe_get_sstride(frame) != (size_t)ao->sstride)
+        return false;
+
+    struct mp_chmap channels;
+    if (!mp_aframe_get_chmap(frame, &channels) ||
+        !mp_chmap_equals(&channels, &ao->channels))
+        return false;
+
+    for (int n = 0; n < ao->num_planes; n++) {
+        if (!data[n])
+            return false;
+    }
+
+    return true;
+}
