diff --git a/audio/out/ao_avfoundation.m b/audio/out/ao_avfoundation.m
--- a/audio/out/ao_avfoundation.m
+++ b/audio/out/ao_avfoundation.m
@@ -34,7 +34,9 @@
 
 @interface AVObserver : NSObject {
     struct ao *ao;
-}
+    BOOL reloadRequested;
+}
+- (void)invalidate;
 - (void)handleRestartNotification:(NSNotification*)notification;
 @end
 
@@ -71,6 +73,10 @@
     int request_sample_count = samplerate / 10;
     int buffer_size = request_sample_count * sstride;
     void *data[] = {CFAllocatorAllocate(NULL, buffer_size, 0)};
+    if (!data[0]) {
+        MP_ERR(ao, "unable to allocate audio buffer\n");
+        goto error;
+    }
 
     int64_t cur_time_av = CMTimeGetNanoseconds([p->synchronizer currentTime]);
     int64_t cur_time_mp = mp_time_ns();
@@ -205,13 +211,20 @@
     }
     return self;
 }
+- (void)invalidate {
+    @synchronized (self) {
+        ao = NULL;
+    }
+}
 - (void)handleRestartNotification:(NSNotification*)notification {
-    // Use NSString -UTF8String (portable) instead of cfstr_get_cstr, whose
-    // implementation (osdep/utils-mac.c) is only built on macOS (Cocoa).
-    MP_WARN(ao, "restarting due to system notification; this will cause desync\n");
-    MP_VERBOSE(ao, "notification name: %s\n", notification.name.UTF8String);
-    stop(ao);
-    start(ao);
+    @synchronized (self) {
+        if (!ao || reloadRequested)
+            return;
+        reloadRequested = YES;
+        MP_WARN(ao, "requesting synchronized audio output recovery\n");
+        MP_VERBOSE(ao, "notification name: %s\n", notification.name.UTF8String);
+        ao_request_reload(ao);
+    }
 }
 @end
 
