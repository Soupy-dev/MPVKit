+static double subtitle_cache_seek_start(struct mkv_demuxer *mkv_d,
+                                         struct mkv_index *index, int seek_id)
+{
+    if (!mkv_d->index_complete || !index || seek_id < 0 ||
+        index->tnum != seek_id || index->timecode < 0 || !mkv_d->tc_scale)
+        return MP_NOPTS_VALUE;
+    double secs = mkv_d->opts->subtitle_preroll_secs;
+    if (mkv_d->index_has_durations)
+        secs = MPMAX(secs, mkv_d->opts->subtitle_preroll_secs_index);
+    double pre_f = secs * 1e9 / mkv_d->tc_scale;
+    if (!isfinite(pre_f) || pre_f < 0 || pre_f >= (double)INT64_MAX)
+        return MP_NOPTS_VALUE;
+    int64_t pre = pre_f;
+    int64_t last_tc = -1;
+    uint64_t last_pos = 0;
+    int64_t first_tc = -1;
+    bool found_index = false;
+    for (size_t n = 0; n < mkv_d->num_indexes; n++) {
+        struct mkv_index *cur = &mkv_d->indexes[n];
+        if (cur->tnum != seek_id)
+            continue;
+        if (cur->timecode < 0 || cur->timecode < last_tc || cur->filepos < last_pos)
+            return MP_NOPTS_VALUE;
+        last_tc = cur->timecode;
+        last_pos = cur->filepos;
+        found_index |= cur == index;
+        if (first_tc < 0 && cur->timecode >= index->timecode &&
+            cur->timecode - index->timecode >= pre)
+            first_tc = cur->timecode;
+    }
+    if (!found_index || first_tc < 0)
+        return MP_NOPTS_VALUE;
+    double pts = first_tc * (double)mkv_d->tc_scale / 1e9 + 1.0;
+    return isfinite(pts) ? pts : MP_NOPTS_VALUE;
 }
 
