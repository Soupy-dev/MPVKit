+
+static size_t subtitle_cache_packet_size(struct demux_packet *dp)
+{
+    size_t size = demux_packet_estimate_total_size(dp);
+    if (dp->avpacket && dp->avpacket->buf && dp->avpacket->buf->size > dp->len)
+        size += dp->avpacket->buf->size - dp->len;
