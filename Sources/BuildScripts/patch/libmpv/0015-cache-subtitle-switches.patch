+
+void demux_disable_subtitle_cache(struct sh_stream *stream)
+{
+    struct demux_internal *in = stream->ds->in;
+    mp_mutex_lock(&in->lock);
+    stream->ds->subtitle_cache_valid = false;
+    mp_mutex_unlock(&in->lock);
+}
+
+bool demux_stream_can_cache_subtitles(struct sh_stream *stream)
+{
+    if (!stream)
+        return false;
+    struct demux_stream *ds = stream->ds;
+    struct demux_internal *in = ds->in;
+    mp_mutex_lock(&in->lock);
+    bool available = ds->subtitle_cache_eligible && ds->subtitle_cache_valid &&
+                     in->subtitle_cache_enabled && !in->back_demuxing;
+    mp_mutex_unlock(&in->lock);
+    return available;
+}
+
+bool demux_stream_should_read(struct sh_stream *stream)
+{
+    if (!stream)
+        return false;
+    struct demux_stream *ds = stream->ds;
+    struct demux_internal *in = ds->in;
+    mp_mutex_lock(&in->lock);
+    bool read = ds->selected ||
+        (ds->subtitle_cache_eligible && ds->subtitle_cache_valid &&
+         in->subtitle_cache_enabled && in->subtitle_cache_start != MP_NOPTS_VALUE &&
+         !in->back_demuxing);
+    mp_mutex_unlock(&in->lock);
+    return read;
 }
 
