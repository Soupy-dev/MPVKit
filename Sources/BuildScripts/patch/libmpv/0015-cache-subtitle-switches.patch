+static void remove_subtitle_cache_head(struct demux_internal *in)
+{
+    struct demux_packet *dp = in->subtitle_cache_head;
+    struct demux_stream *ds = in->streams[dp->stream]->ds;
+    ds->subtitle_cache_pruned = MP_PTS_MAX(ds->subtitle_cache_pruned,
+                                         dp->pts + dp->duration);
+    in->subtitle_cache_bytes -= subtitle_cache_packet_size(dp);
+    in->subtitle_cache_packets--;
+    in->subtitle_cache_head = dp->next;
+    if (!in->subtitle_cache_head)
+        in->subtitle_cache_tail = NULL;
+    demux_packet_pool_push(in->packet_pool, dp);
+}
+
+static void clear_subtitle_cache(struct demux_internal *in, bool from_start)
+{
+    in->subtitle_cache_generation++;
+    while (in->subtitle_cache_head)
+        remove_subtitle_cache_head(in);
+    in->subtitle_cache_start = from_start ? -DBL_MAX : MP_NOPTS_VALUE;
+    in->subtitle_cache_end = MP_NOPTS_VALUE;
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *ds = in->streams[n]->ds;
+        ds->subtitle_cache_pruned = MP_NOPTS_VALUE;
+        ds->subtitle_cache_valid = true;
+    }
+}
+
+static void cache_subtitle_packet(struct demux_stream *ds, struct demux_packet *dp)
+{
+    struct demux_internal *in = ds->in;
+    if (!in->subtitle_cache_enabled || in->subtitle_cache_start == MP_NOPTS_VALUE ||
+        in->subtitle_cache_replaying || in->seeking || in->back_demuxing)
+        return;
+    if (dp->segmented) {
+        clear_subtitle_cache(in, false);
+        return;
+    }
+    if (ds->type != STREAM_SUB && ds->selected) {
+        double ts = MP_PTS_OR_DEF(dp->dts, dp->pts);
+        if (ts != MP_NOPTS_VALUE && isfinite(ts))
+            in->subtitle_cache_end = MP_PTS_MAX(in->subtitle_cache_end, ts);
+        return;
+    }
+    if (!ds->subtitle_cache_eligible || !ds->subtitle_cache_valid)
+        return;
+    size_t size = subtitle_cache_packet_size(dp);
+    if (dp->pts == MP_NOPTS_VALUE || !isfinite(dp->pts) ||
+        !isfinite(dp->duration) || dp->duration < 0 ||
+        !isfinite(dp->pts + dp->duration) || size > SUBTITLE_CACHE_MAX_BYTES)
+    {
+        ds->subtitle_cache_valid = false;
+        return;
+    }
+    while (in->subtitle_cache_head &&
+           (in->subtitle_cache_packets >= SUBTITLE_CACHE_MAX_PACKETS ||
+            in->subtitle_cache_bytes > SUBTITLE_CACHE_MAX_BYTES - size))
+        remove_subtitle_cache_head(in);
+    struct demux_packet *copy = demux_copy_packet(in->packet_pool, dp);
+    if (!copy) {
+        ds->subtitle_cache_valid = false;
+        return;
+    }
+    if (in->subtitle_cache_tail)
+        in->subtitle_cache_tail->next = copy;
+    else
+        in->subtitle_cache_head = copy;
+    in->subtitle_cache_tail = copy;
+    in->subtitle_cache_bytes += size;
+    in->subtitle_cache_packets++;
+}
 
