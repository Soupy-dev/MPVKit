+static bool restore_cached_subtitles(struct demux_stream *ds, double ref_pts)
+{
+    struct demux_internal *in = ds->in;
+    double refresh_pts = ref_pts;
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *other = in->streams[n]->ds;
+        if (other->selected && other->type != STREAM_SUB)
+            refresh_pts = MP_PTS_MIN(refresh_pts, other->base_ts);
+    }
+    if (!ds->subtitle_cache_eligible || !ds->subtitle_cache_valid || ds->refreshing ||
+        !in->subtitle_cache_enabled || in->subtitle_cache_start == MP_NOPTS_VALUE ||
+        in->back_demuxing || in->seeking || ref_pts == MP_NOPTS_VALUE ||
+        !isfinite(ref_pts) || in->subtitle_cache_end == MP_NOPTS_VALUE ||
+        in->subtitle_cache_start > refresh_pts || in->subtitle_cache_end < ref_pts ||
+        (ds->subtitle_cache_pruned != MP_NOPTS_VALUE &&
+         ds->subtitle_cache_pruned >= ref_pts))
+        return false;
+    struct demux_packet *head = NULL;
+    struct demux_packet *tail = NULL;
+    for (struct demux_packet *dp = in->subtitle_cache_head; dp; dp = dp->next) {
+        if (dp->stream != ds->index || dp->pts + dp->duration < ref_pts)
+            continue;
+        struct demux_packet *copy = demux_copy_packet(in->packet_pool, dp);
+        if (!copy) {
+            demux_packet_pool_prepend(in->packet_pool, head, tail);
+            return false;
+        }
+        if (tail)
+            tail->next = copy;
+        else
+            head = copy;
+        tail = copy;
+    }
+    ds_clear_reader_queue_state(ds);
+    clear_queue(ds->queue);
+    double demux_ts = in->demux_ts;
+    bool eof = in->eof;
+    in->subtitle_cache_replaying = true;
+    while (head) {
+        struct demux_packet *dp = head;
+        head = dp->next;
+        dp->next = NULL;
+        add_packet_locked(ds->sh, dp);
+    }
+    in->subtitle_cache_replaying = false;
+    in->demux_ts = demux_ts;
+    in->eof = eof;
+    MP_VERBOSE(in, "restored cached subtitle track %d without seeking\n", ds->index);
+    return true;
+}
