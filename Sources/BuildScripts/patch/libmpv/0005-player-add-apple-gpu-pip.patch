+
+#if HAVE_APPLE_GPU_PIP
+static bool apple_pip_direct_supported(struct vo *vo, char *reason,
+                                       size_t reason_size)
+{
+    struct priv *p = vo->priv;
+    const char *failure = NULL;
+
+    if (!vo->context_name || strcmp(vo->context_name, "moltenvk") != 0) {
+        failure = "gpu-next is not using the moltenvk context";
+    } else if (!pl_vulkan_get(p->gpu)) {
+        failure = "libplacebo is not using a Vulkan GPU";
+    } else if (!p->gpu->limits.thread_safe) {
+        failure = "libplacebo Vulkan polling is not thread-safe";
+    } else if (!(p->gpu->import_caps.tex & PL_HANDLE_IOSURFACE)) {
+        failure = "direct IOSurface import is not advertised";
+    } else {
+        pl_fmt fmt = pl_find_named_fmt(p->gpu, "bgra8");
+        enum pl_fmt_caps required = PL_FMT_CAP_RENDERABLE |
+                                    PL_FMT_CAP_BLITTABLE;
+        if (!fmt || (fmt->caps & required) != required)
+            failure = "renderable/blittable BGRA8 is unavailable";
+    }
+
+    if (failure) {
+        snprintf(reason, reason_size,
+                 "%s; no safe GPU blit fallback is enabled", failure);
+    } else {
+        snprintf(reason, reason_size,
+                 "direct IOSurface gpu-next output ready");
+    }
+    return !failure;
+}
+
+static bool apple_pip_has_slots_locked(struct apple_pip_state *state)
+{
+    for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+        if (state->slots[i].state != APPLE_PIP_SLOT_FREE)
+            return true;
+    }
+    return false;
+}
+
+static bool apple_pip_claim_forced_redraw_locked(
+    struct apple_pip_state *state)
+{
+    if (!state->force_redraw_armed)
+        return false;
+
+    for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+        struct apple_pip_slot *slot = &state->slots[i];
+        if (slot->state == APPLE_PIP_SLOT_QUEUED &&
+            slot->generation == state->generation) {
+            state->force_redraw_armed = false;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void apple_pip_cancel_locked(struct apple_pip_state *state,
+                                    uint32_t status)
+{
+    for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+        struct apple_pip_slot *slot = &state->slots[i];
+        switch (slot->state) {
+        case APPLE_PIP_SLOT_QUEUED:
+            slot->completion_status = status;
+            slot->state = APPLE_PIP_SLOT_CANCELED;
+            break;
+        case APPLE_PIP_SLOT_RENDERING:
+            // draw_frame owns this slot until apple_pip_complete_render().
+            // Preserve its state so the worker cannot destroy the texture
+            // while it is being encoded into a GPU command buffer.
+            if (slot->completion_status == MPV_APPLE_PIP_FRAME_READY)
+                slot->completion_status = status;
+            break;
+        case APPLE_PIP_SLOT_IN_FLIGHT:
+            if (slot->completion_status == MPV_APPLE_PIP_FRAME_READY)
+                slot->completion_status = status;
+            break;
+        default:
+            break;
+        }
+    }
+    mp_cond_broadcast(&state->wakeup);
+}
+
+static MP_THREAD_VOID apple_pip_completion_worker(void *opaque)
+{
+    struct vo *vo = opaque;
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    mp_thread_set_name("mpv/apple-pip");
+
+    while (true) {
+        struct apple_pip_slot *slot = NULL;
+        pl_tex tex = NULL;
+        bool needs_poll = false;
+
+        mp_mutex_lock(&state->lock);
+        for (;;) {
+            for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+                enum apple_pip_slot_state s = state->slots[i].state;
+                if (s == APPLE_PIP_SLOT_CANCELED ||
+                    s == APPLE_PIP_SLOT_IN_FLIGHT) {
+                    slot = &state->slots[i];
+                    tex = slot->tex;
+                    // Import/initial-layout work can be pending even when a
+                    // queued target is canceled before its first render.
+                    needs_poll = tex != NULL;
+                    break;
+                }
+            }
+
+            if (slot || (state->shutting_down &&
+                         !apple_pip_has_slots_locked(state)))
+                break;
+            mp_cond_wait(&state->wakeup, &state->lock);
+        }
+
+        if (!slot) {
+            mp_mutex_unlock(&state->lock);
+            break;
+        }
+        mp_mutex_unlock(&state->lock);
+
+        if (needs_poll && pl_tex_poll(p->gpu, tex, MP_TIME_MS_TO_NS(20)))
+            continue;
+
+        struct mpv_apple_pip_frame frame = {0};
+        mpv_apple_pip_frame_callback callback = NULL;
+        void *callback_ctx = NULL;
+        IOSurfaceRef surface = NULL;
+
+        mp_mutex_lock(&state->lock);
+        if (slot->state != APPLE_PIP_SLOT_CANCELED &&
+            slot->state != APPLE_PIP_SLOT_IN_FLIGHT) {
+            mp_mutex_unlock(&state->lock);
+            continue;
+        }
+
+        if (slot->completion_status == MPV_APPLE_PIP_FRAME_READY &&
+            slot->generation != state->generation)
+            slot->completion_status = MPV_APPLE_PIP_FRAME_STALE;
+
+        frame = (struct mpv_apple_pip_frame) {
+            .struct_size = sizeof(frame),
+            .status = slot->completion_status,
+            .width = slot->width,
+            .height = slot->height,
+            .pixel_format = MPV_APPLE_PIP_PIXEL_FORMAT_BGRA,
+            .token = slot->token,
+            .generation = slot->generation,
+            .pts = slot->pts,
+            .duration = slot->duration,
+        };
+        callback = state->callback;
+        callback_ctx = state->callback_ctx;
+        surface = slot->surface;
+        slot->state = APPLE_PIP_SLOT_CALLBACK;
+        mp_mutex_unlock(&state->lock);
+
+        if (tex)
+            pl_tex_destroy(p->gpu, &tex);
+        if (surface)
+            CFRelease(surface);
+        if (callback)
+            callback(callback_ctx, &frame);
+
+        mp_mutex_lock(&state->lock);
+        memset(slot, 0, sizeof(*slot));
+        mp_cond_broadcast(&state->wakeup);
+        mp_mutex_unlock(&state->lock);
+    }
+
+    MP_THREAD_RETURN();
+}
+
+static void apple_pip_init(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    if (mp_mutex_init(&state->lock)) {
+        snprintf(state->diagnostic, sizeof(state->diagnostic),
+                 "failed initializing completion mutex");
+        return;
+    }
+    if (mp_cond_init(&state->wakeup)) {
+        mp_mutex_destroy(&state->lock);
+        snprintf(state->diagnostic, sizeof(state->diagnostic),
+                 "failed initializing completion condition");
+        return;
+    }
+
+    state->initialized = true;
+    state->mode = MPV_APPLE_PIP_MODE_INLINE_ONLY;
+    if (!apple_pip_direct_supported(vo, state->diagnostic,
+                                    sizeof(state->diagnostic)))
+        return;
+
+    if (mp_thread_create(&state->worker, apple_pip_completion_worker, vo)) {
+        snprintf(state->diagnostic, sizeof(state->diagnostic),
+                 "failed starting completion worker");
+        return;
+    }
+    state->worker_started = true;
+}
+
+static void apple_pip_uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->initialized)
+        return;
+
+    mp_mutex_lock(&state->lock);
+    state->mode = MPV_APPLE_PIP_MODE_INLINE_ONLY;
+    state->force_redraw_armed = false;
+    state->callback = NULL;
+    state->callback_ctx = NULL;
+    state->shutting_down = true;
+    apple_pip_cancel_locked(state, MPV_APPLE_PIP_FRAME_CANCELED);
+    mp_mutex_unlock(&state->lock);
+
+    if (state->worker_started)
+        mp_thread_join(state->worker);
+
+    mp_cond_destroy(&state->wakeup);
+    mp_mutex_destroy(&state->lock);
+    state->initialized = false;
+}
+
+static bool apple_pip_inline_enabled(struct priv *p)
+{
+    return !p->apple_pip.initialized ||
+           p->apple_pip.mode != MPV_APPLE_PIP_MODE_OFFSCREEN_ONLY;
+}
+
+static bool apple_pip_output_enabled(struct priv *p)
+{
+    return p->apple_pip.initialized &&
+           p->apple_pip.mode != MPV_APPLE_PIP_MODE_INLINE_ONLY;
+}
+
+static struct apple_pip_slot *apple_pip_take_target(struct priv *p)
+{
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->worker_started || !apple_pip_output_enabled(p))
+        return NULL;
+
+    struct apple_pip_slot *result = NULL;
+    mp_mutex_lock(&state->lock);
+    for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+        struct apple_pip_slot *slot = &state->slots[i];
+        if (slot->state != APPLE_PIP_SLOT_QUEUED)
+            continue;
+        if (slot->generation != state->generation) {
+            slot->completion_status = MPV_APPLE_PIP_FRAME_STALE;
+            slot->state = APPLE_PIP_SLOT_CANCELED;
+            continue;
+        }
+        slot->state = APPLE_PIP_SLOT_RENDERING;
+        result = slot;
+        break;
+    }
+    mp_cond_broadcast(&state->wakeup);
+    mp_mutex_unlock(&state->lock);
+    return result;
+}
+
+static void apple_pip_complete_render(struct priv *p,
+                                      struct apple_pip_slot *slot,
+                                      bool gpu_used, bool ready, double pts,
+                                      double duration)
+{
+    if (!slot)
+        return;
+
+    struct apple_pip_state *state = &p->apple_pip;
+    mp_mutex_lock(&state->lock);
+    slot->pts = pts;
+    slot->duration = duration;
+    if (slot->completion_status == MPV_APPLE_PIP_FRAME_READY) {
+        slot->completion_status = ready ? MPV_APPLE_PIP_FRAME_READY
+                                        : MPV_APPLE_PIP_FRAME_RENDER_FAILED;
+    }
+    slot->state = gpu_used ? APPLE_PIP_SLOT_IN_FLIGHT
+                           : APPLE_PIP_SLOT_CANCELED;
+    mp_cond_broadcast(&state->wakeup);
+    mp_mutex_unlock(&state->lock);
+}
+
+static void apple_pip_make_target(struct priv *p,
+                                  struct apple_pip_slot *slot,
+                                  struct pl_frame *target,
+                                  struct mp_rect *dst,
+                                  struct mp_osd_res *osd)
+{
+    *target = (struct pl_frame) {
+        .repr = pl_color_repr_rgb,
+        .color = pl_color_space_srgb,
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = slot->tex,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        },
+    };
+    target->color.primaries = PL_COLOR_PRIM_BT_709;
+    target->color.transfer = PL_COLOR_TRC_SRGB;
+    target->repr.levels = PL_COLOR_LEVELS_FULL;
+
+    double aspect = 0.0;
+    int current_w = abs(mp_rect_w(p->dst));
+    int current_h = abs(mp_rect_h(p->dst));
+    if (current_w > 0 && current_h > 0)
+        aspect = (double)current_w / current_h;
+    if (!(aspect > 0.0) || !isfinite(aspect))
+        aspect = (double)slot->width / slot->height;
+
+    int width = slot->width;
+    int height = lround(width / aspect);
+    if (height > (int)slot->height) {
+        height = slot->height;
+        width = lround(height * aspect);
+    }
+    width = MPMAX(1, MPMIN(width, (int)slot->width));
+    height = MPMAX(1, MPMIN(height, (int)slot->height));
+    int left = ((int)slot->width - width) / 2;
+    int top = ((int)slot->height - height) / 2;
+    *dst = (struct mp_rect) {left, top, left + width, top + height};
+    *osd = (struct mp_osd_res) {
+        .w = slot->width,
+        .h = slot->height,
+        .ml = left,
+        .mr = slot->width - dst->x1,
+        .mt = top,
+        .mb = slot->height - dst->y1,
+        .display_par = 1.0,
+    };
+    apply_crop(target, *dst, slot->width, slot->height);
+}
+
+static int apple_pip_get_capabilities(struct vo *vo,
+                                      struct mpv_apple_pip_capabilities *caps)
+{
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    uint32_t size = caps->struct_size;
+    memset(caps, 0, sizeof(*caps));
+    caps->struct_size = size;
+    caps->api_version = MPV_APPLE_PIP_API_VERSION;
+    caps->pixel_format = MPV_APPLE_PIP_PIXEL_FORMAT_BGRA;
+    caps->max_queued_targets = APPLE_PIP_MAX_TARGETS;
+    snprintf(caps->diagnostic, sizeof(caps->diagnostic), "%s",
+             state->diagnostic[0] ? state->diagnostic : "not initialized");
+
+    if (!state->worker_started)
+        return MPV_APPLE_PIP_UNSUPPORTED;
+
+    caps->flags = MPV_APPLE_PIP_CAP_DIRECT_IOSURFACE |
+                  MPV_APPLE_PIP_CAP_SDR_BGRA8 |
+                  MPV_APPLE_PIP_CAP_OFFSCREEN_WITHOUT_DRAWABLE |
+                  MPV_APPLE_PIP_CAP_ASYNC_COMPLETION;
+    return MPV_APPLE_PIP_OK;
+}
+
+static int apple_pip_set_callback(struct priv *p,
+                                  struct voctrl_apple_pip_callback *config)
+{
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->worker_started)
+        return MPV_APPLE_PIP_UNSUPPORTED;
+
+    mp_mutex_lock(&state->lock);
+    state->callback = config->callback;
+    state->callback_ctx = config->callback_ctx;
+    mp_mutex_unlock(&state->lock);
+    return MPV_APPLE_PIP_OK;
+}
+
+static int apple_pip_set_mode(struct vo *vo,
+                              struct voctrl_apple_pip_mode *config)
+{
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->worker_started)
+        return MPV_APPLE_PIP_UNSUPPORTED;
+
+    bool force_redraw = false;
+    mp_mutex_lock(&state->lock);
+    if (state->shutting_down) {
+        mp_mutex_unlock(&state->lock);
+        return MPV_APPLE_PIP_UNAVAILABLE;
+    }
+    bool new_generation = config->generation != state->generation;
+    bool new_warmup = config->mode == MPV_APPLE_PIP_MODE_DUAL_OUTPUT_WARMUP &&
+                      state->mode != MPV_APPLE_PIP_MODE_DUAL_OUTPUT_WARMUP;
+    bool new_restore = config->mode == MPV_APPLE_PIP_MODE_DUAL_OUTPUT_RESTORE &&
+                       state->mode != MPV_APPLE_PIP_MODE_DUAL_OUTPUT_RESTORE;
+    if (new_generation)
+        apple_pip_cancel_locked(state, MPV_APPLE_PIP_FRAME_STALE);
+    state->generation = config->generation;
+    state->mode = config->mode;
+    if (config->mode == MPV_APPLE_PIP_MODE_INLINE_ONLY) {
+        state->force_redraw_armed = false;
+        apple_pip_cancel_locked(state, MPV_APPLE_PIP_FRAME_CANCELED);
+    } else if (new_generation || new_warmup || new_restore) {
+        // A single forced draw prepares or restores PiP while paused.
+        // Thereafter surfaces are merely available targets and are consumed
+        // only by natural VO draws, preventing callback/refill from becoming
+        // an unbounded loop.
+        state->force_redraw_armed = true;
+        force_redraw = apple_pip_claim_forced_redraw_locked(state);
+    }
+    mp_mutex_unlock(&state->lock);
+
+    if (force_redraw)
+        vo->want_redraw = true;
+    return MPV_APPLE_PIP_OK;
+}
+
+static int apple_pip_submit_target(struct vo *vo,
+                                   const struct mpv_apple_pip_target *target)
+{
+    struct priv *p = vo->priv;
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->worker_started)
+        return MPV_APPLE_PIP_UNSUPPORTED;
+    if (!target->io_surface || !target->width || !target->height ||
+        target->pixel_format != MPV_APPLE_PIP_PIXEL_FORMAT_BGRA)
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    IOSurfaceRef surface = target->io_surface;
+    if (IOSurfaceGetWidth(surface) != target->width ||
+        IOSurfaceGetHeight(surface) != target->height ||
+        IOSurfaceGetBytesPerElement(surface) != 4 ||
+        IOSurfaceGetPixelFormat(surface) != MPV_APPLE_PIP_PIXEL_FORMAT_BGRA)
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    bool force_redraw = false;
+    mp_mutex_lock(&state->lock);
+    if (state->shutting_down ||
+        state->mode == MPV_APPLE_PIP_MODE_INLINE_ONLY) {
+        mp_mutex_unlock(&state->lock);
+        return MPV_APPLE_PIP_UNAVAILABLE;
+    }
+    if (target->generation != state->generation) {
+        mp_mutex_unlock(&state->lock);
+        return MPV_APPLE_PIP_STALE_GENERATION;
+    }
+
+    struct apple_pip_slot *slot = NULL;
+    for (int i = 0; i < APPLE_PIP_MAX_TARGETS; i++) {
+        struct apple_pip_slot *candidate = &state->slots[i];
+        if (candidate->state != APPLE_PIP_SLOT_FREE &&
+            candidate->surface == surface) {
+            mp_mutex_unlock(&state->lock);
+            return MPV_APPLE_PIP_BUSY;
+        }
+        if (!slot && candidate->state == APPLE_PIP_SLOT_FREE)
+            slot = candidate;
+    }
+    mp_mutex_unlock(&state->lock);
+    if (!slot)
+        return MPV_APPLE_PIP_BUSY;
+
+    pl_fmt fmt = pl_find_named_fmt(p->gpu, "bgra8");
+    CFRetain(surface);
+    pl_tex tex = pl_tex_create(p->gpu, pl_tex_params(
+        .w = target->width,
+        .h = target->height,
+        .format = fmt,
+        .renderable = true,
+        .blit_dst = true,
+        .import_handle = PL_HANDLE_IOSURFACE,
+        .shared_mem = {
+            .handle.handle = surface,
+            .size = IOSurfaceGetAllocSize(surface),
+        },
+        .debug_tag = "MPVKit PiP IOSurface",
+    ));
+    if (!tex) {
+        CFRelease(surface);
+        snprintf(state->diagnostic, sizeof(state->diagnostic),
+                 "direct IOSurface import failed for %ux%u BGRA; "
+                 "no safe GPU blit fallback is enabled",
+                 target->width, target->height);
+        MP_ERR(vo, "%s\n", state->diagnostic);
+        return MPV_APPLE_PIP_IMPORT_FAILED;
+    }
+
+    mp_mutex_lock(&state->lock);
+    if (state->shutting_down || target->generation != state->generation ||
+        slot->state != APPLE_PIP_SLOT_FREE) {
+        mp_mutex_unlock(&state->lock);
+        pl_tex_destroy(p->gpu, &tex);
+        CFRelease(surface);
+        return MPV_APPLE_PIP_STALE_GENERATION;
+    }
+    *slot = (struct apple_pip_slot) {
+        .state = APPLE_PIP_SLOT_QUEUED,
+        .tex = tex,
+        .surface = surface,
+        .width = target->width,
+        .height = target->height,
+        .token = target->token,
+        .generation = target->generation,
+        .completion_status = MPV_APPLE_PIP_FRAME_READY,
+    };
+    force_redraw = apple_pip_claim_forced_redraw_locked(state);
+    mp_mutex_unlock(&state->lock);
+
+    if (force_redraw)
+        vo->want_redraw = true;
+    return MPV_APPLE_PIP_OK;
+}
+
+static int apple_pip_disable_and_drain(struct priv *p)
+{
+    struct apple_pip_state *state = &p->apple_pip;
+    if (!state->initialized)
+        return MPV_APPLE_PIP_UNAVAILABLE;
+
+    mp_mutex_lock(&state->lock);
+    state->mode = MPV_APPLE_PIP_MODE_INLINE_ONLY;
+    state->force_redraw_armed = false;
+    state->callback = NULL;
+    state->callback_ctx = NULL;
+    apple_pip_cancel_locked(state, MPV_APPLE_PIP_FRAME_CANCELED);
+    while (apple_pip_has_slots_locked(state))
+        mp_cond_wait(&state->wakeup, &state->lock);
+    mp_mutex_unlock(&state->lock);
+    return MPV_APPLE_PIP_OK;
+}
