+MPV_APPLE_PIP_EXPORT uint32_t mpv_apple_pip_api_version(void)
+{
+    return MPV_APPLE_PIP_API_VERSION;
+}
+
+static int apple_pip_control(mpv_handle *ctx, int request, void *data)
+{
+    if (!ctx)
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    lock_core(ctx);
+    struct vo *vo = ctx->mpctx->video_out;
+    int result;
+    if (!vo) {
+        result = MPV_APPLE_PIP_UNAVAILABLE;
+    } else if (strcmp(vo->driver->name, "gpu-next") != 0) {
+        result = MPV_APPLE_PIP_WRONG_VIDEO_OUTPUT;
+    } else {
+        result = vo_control(vo, request, data);
+    }
+    unlock_core(ctx);
+    return result;
+}
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_get_capabilities(
+    mpv_handle *ctx, struct mpv_apple_pip_capabilities *capabilities)
+{
+    if (!capabilities ||
+        capabilities->struct_size < sizeof(*capabilities))
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    return apple_pip_control(ctx, VOCTRL_APPLE_PIP_GET_CAPABILITIES,
+                             capabilities);
+}
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_set_callback(
+    mpv_handle *ctx, mpv_apple_pip_frame_callback callback,
+    void *callback_ctx)
+{
+    struct voctrl_apple_pip_callback config = {
+        .callback = callback,
+        .callback_ctx = callback_ctx,
+    };
+    return apple_pip_control(ctx, VOCTRL_APPLE_PIP_SET_CALLBACK, &config);
+}
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_set_mode(
+    mpv_handle *ctx, uint32_t mode, uint64_t generation)
+{
+    if (mode > MPV_APPLE_PIP_MODE_DUAL_OUTPUT_RESTORE || !generation)
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    struct voctrl_apple_pip_mode config = {
+        .mode = mode,
+        .generation = generation,
+    };
+    return apple_pip_control(ctx, VOCTRL_APPLE_PIP_SET_MODE, &config);
+}
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_submit_target(
+    mpv_handle *ctx, const struct mpv_apple_pip_target *target)
+{
+    if (!target || target->struct_size < sizeof(*target))
+        return MPV_APPLE_PIP_INVALID_ARGUMENT;
+
+    return apple_pip_control(ctx, VOCTRL_APPLE_PIP_SUBMIT_TARGET,
+                             (void *)target);
+}
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_disable_and_drain(mpv_handle *ctx)
+{
+    return apple_pip_control(ctx, VOCTRL_APPLE_PIP_DISABLE_AND_DRAIN, NULL);
+}
+
