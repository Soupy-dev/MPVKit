+ */
+
+#ifndef MPV_CLIENT_API_APPLE_PIP_H_
+#define MPV_CLIENT_API_APPLE_PIP_H_
+
+#include <stdint.h>
+
+#include "client.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MPV_APPLE_PIP_API_VERSION 1u
+#define MPV_APPLE_PIP_PIXEL_FORMAT_BGRA 0x42475241u
+
+/*
+ * MPVKit ships libmpv as a static XCFramework. Keep these optional entry
+ * points in the final Mach-O image so clients may resolve the stable names
+ * with dlsym even when Release builds enable dead stripping.
+ */
+#if defined(__has_attribute)
+# if __has_attribute(retain)
+#  define MPV_APPLE_PIP_RETAIN __attribute__((used, retain))
+# elif __has_attribute(used)
+#  define MPV_APPLE_PIP_RETAIN __attribute__((used))
+# else
+#  define MPV_APPLE_PIP_RETAIN
+# endif
+#else
+# define MPV_APPLE_PIP_RETAIN
+#endif
+#define MPV_APPLE_PIP_EXPORT MPV_EXPORT MPV_APPLE_PIP_RETAIN
+
+enum mpv_apple_pip_result {
+    MPV_APPLE_PIP_OK = 0,
+    MPV_APPLE_PIP_UNAVAILABLE = -1,
+    MPV_APPLE_PIP_INVALID_ARGUMENT = -2,
+    MPV_APPLE_PIP_WRONG_VIDEO_OUTPUT = -3,
+    MPV_APPLE_PIP_UNSUPPORTED = -4,
+    MPV_APPLE_PIP_BUSY = -5,
+    MPV_APPLE_PIP_STALE_GENERATION = -6,
+    MPV_APPLE_PIP_IMPORT_FAILED = -7,
+    MPV_APPLE_PIP_INTERNAL_ERROR = -8,
+};
+
+enum mpv_apple_pip_mode {
+    MPV_APPLE_PIP_MODE_INLINE_ONLY = 0,
+    MPV_APPLE_PIP_MODE_DUAL_OUTPUT_WARMUP = 1,
+    MPV_APPLE_PIP_MODE_OFFSCREEN_ONLY = 2,
+    MPV_APPLE_PIP_MODE_DUAL_OUTPUT_RESTORE = 3,
+};
+
+enum mpv_apple_pip_capability {
+    MPV_APPLE_PIP_CAP_DIRECT_IOSURFACE = 1ull << 0,
+    MPV_APPLE_PIP_CAP_SDR_BGRA8 = 1ull << 1,
+    MPV_APPLE_PIP_CAP_OFFSCREEN_WITHOUT_DRAWABLE = 1ull << 2,
+    MPV_APPLE_PIP_CAP_ASYNC_COMPLETION = 1ull << 3,
+};
+
+enum mpv_apple_pip_frame_status {
+    MPV_APPLE_PIP_FRAME_READY = 0,
+    MPV_APPLE_PIP_FRAME_STALE = 1,
+    MPV_APPLE_PIP_FRAME_CANCELED = 2,
+    MPV_APPLE_PIP_FRAME_RENDER_FAILED = 3,
+};
+
+struct mpv_apple_pip_capabilities {
+    uint32_t struct_size;
+    uint32_t api_version;
+    uint64_t flags;
+    uint32_t pixel_format;
+    uint32_t max_queued_targets;
+    char diagnostic[160];
+};
+
+/*
+ * io_surface is an IOSurfaceRef passed as an untyped pointer. The caller must
+ * keep the IOSurface and its CVPixelBuffer alive until the completion callback.
+ * Submitting the same IOSurface while it is queued or GPU-in-flight returns
+ * MPV_APPLE_PIP_BUSY.
+ */
+struct mpv_apple_pip_target {
+    uint32_t struct_size;
+    uint32_t width;
+    uint32_t height;
+    uint32_t pixel_format;
+    void *io_surface;
+    uint64_t token;
+    uint64_t generation;
+};
+
+struct mpv_apple_pip_frame {
+    uint32_t struct_size;
+    uint32_t status;
+    uint32_t width;
+    uint32_t height;
+    uint32_t pixel_format;
+    uint32_t reserved;
+    uint64_t token;
+    uint64_t generation;
+    double pts;
+    double duration;
+};
+
+/*
+ * The frame pointer is valid only for the duration of the callback. Callbacks
+ * run on a completion worker, must return promptly, and must not call blocking
+ * libmpv APIs. Dispatch application and AVSampleBufferDisplayLayer work to an
+ * application-owned queue. generation is always copied from the submitted
+ * target; discard any callback whose generation no longer matches the
+ * application's current load, regardless of status.
+ */
+typedef void (*mpv_apple_pip_frame_callback)(
+    void *callback_ctx, const struct mpv_apple_pip_frame *frame);
+
+MPV_APPLE_PIP_EXPORT uint32_t mpv_apple_pip_api_version(void);
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_get_capabilities(
+    mpv_handle *ctx, struct mpv_apple_pip_capabilities *capabilities);
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_set_callback(
+    mpv_handle *ctx, mpv_apple_pip_frame_callback callback,
+    void *callback_ctx);
+
+/*
+ * generation must be nonzero. Increment it before every new media load or PiP
+ * preparation cycle so queued and GPU-in-flight work can be rejected safely.
+ */
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_set_mode(
+    mpv_handle *ctx, uint32_t mode, uint64_t generation);
+
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_submit_target(
+    mpv_handle *ctx, const struct mpv_apple_pip_target *target);
+
+/*
+ * Switches to inline-only, prevents future callbacks, cancels queued targets,
+ * waits for GPU-in-flight targets and callbacks to drain, and releases all
+ * retained IOSurfaces. A callback already claimed by the completion worker may
+ * finish during this call, but no callback can occur after it returns. Register
+ * the callback again before a later PiP cycle.
+ */
+MPV_APPLE_PIP_EXPORT int mpv_apple_pip_disable_and_drain(mpv_handle *ctx);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
