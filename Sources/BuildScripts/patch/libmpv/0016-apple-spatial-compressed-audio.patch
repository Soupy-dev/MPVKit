diff --git a/audio/out/ao_avfoundation_eac3.h b/audio/out/ao_avfoundation_eac3.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ao_avfoundation_eac3.h
@@ -0,0 +1,174 @@
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libavformat/avformat.h>
+#include <libavutil/intreadwrite.h>
+
+#define MPV_APPLE_EAC3_BURST_BYTES 24576
+#define MPV_APPLE_EAC3_CARRIER_SAMPLES 6144
+
+struct mpv_apple_eac3_packet {
+    uint8_t data[MPV_APPLE_EAC3_BURST_BYTES - 8];
+    size_t size;
+    AudioStreamPacketDescription packets[6];
+    int packet_count;
+    int channels;
+    int sample_rate;
+};
+
+static bool mpv_apple_eac3_unpack(const uint8_t *burst, size_t size,
+                                  struct mpv_apple_eac3_packet *out)
+{
+    if (!burst || !out || size != MPV_APPLE_EAC3_BURST_BYTES ||
+        AV_RL16(burst) != 0xf872 || AV_RL16(burst + 2) != 0x4e1f ||
+        AV_RL16(burst + 4) != 0x15)
+        return false;
+    size_t payload = AV_RL16(burst + 6);
+    if (payload < 7 || payload > sizeof(out->data) || (payload & 1))
+        return false;
+    memset(out, 0, sizeof(*out));
+    out->size = payload;
+    for (size_t i = 0; i < payload; i += 2) {
+        out->data[i] = burst[i + 9];
+        out->data[i + 1] = burst[i + 8];
+    }
+    size_t offset = 0;
+    int total_samples = 0;
+    static const int channel_counts[] = {2, 1, 2, 3, 3, 4, 4, 5};
+    static const int blocks[] = {1, 2, 3, 6};
+    while (offset < payload) {
+        const uint8_t *frame = out->data + offset;
+        if (payload - offset < 7 || AV_RB16(frame) != 0x0b77)
+            return false;
+        size_t frame_size = ((((unsigned)frame[2] & 7) << 8) | frame[3]) * 2 + 2;
+        int stream_type = frame[2] >> 6;
+        int substream_id = (frame[2] >> 3) & 7;
+        int bsid = frame[5] >> 3;
+        if (frame_size < 7 || frame_size > payload - offset || stream_type == 3 ||
+            substream_id != 0 || bsid <= 10 || bsid > 16 || (frame[4] >> 6) != 0)
+            return false;
+        int samples = blocks[(frame[4] >> 4) & 3] * 256;
+        if (stream_type == 1) {
+            if (!out->packet_count || samples != out->packets[out->packet_count - 1].mVariableFramesInPacket)
+                return false;
+            out->packets[out->packet_count - 1].mDataByteSize += (UInt32)frame_size;
+        } else {
+            int channels = channel_counts[(frame[4] >> 1) & 7] + (frame[4] & 1);
+            if (out->packet_count >= 6 || (out->channels && channels != out->channels))
+                return false;
+            out->channels = channels;
+            out->sample_rate = 48000;
+            out->packets[out->packet_count++] = (AudioStreamPacketDescription) {
+                .mStartOffset = offset,
+                .mVariableFramesInPacket = samples,
+                .mDataByteSize = (UInt32)frame_size,
+            };
+            total_samples += samples;
+        }
+        offset += frame_size;
+    }
+    return total_samples == 1536 && out->packet_count > 0;
+}
+
+static const uint8_t *mpv_apple_eac3_cookie(const uint8_t *bytes, size_t length,
+                                           int depth, size_t *cookie_size)
+{
+    if (depth > 8)
+        return NULL;
+    for (size_t offset = 0; offset + 8 <= length;) {
+        uint32_t size = AV_RB32(bytes + offset);
+        if (size < 8 || size > length - offset)
+            return NULL;
+        const uint8_t *type = bytes + offset + 4;
+        if (!memcmp(type, "dec3", 4)) {
+            if (size < 11 || size > 128)
+                return NULL;
+            *cookie_size = size;
+            return bytes + offset;
+        }
+        size_t prefix = 0;
+        if (!memcmp(type, "moov", 4) || !memcmp(type, "trak", 4) ||
+            !memcmp(type, "mdia", 4) || !memcmp(type, "minf", 4) || !memcmp(type, "stbl", 4))
+            prefix = 8;
+        else if (!memcmp(type, "stsd", 4))
+            prefix = 16;
+        else if (!memcmp(type, "ec-3", 4))
+            prefix = 36;
+        if (prefix && size > prefix) {
+            const uint8_t *found = mpv_apple_eac3_cookie(bytes + offset + prefix,
+                size - prefix, depth + 1, cookie_size);
+            if (found)
+                return found;
+        }
+        offset += size;
+    }
+    return NULL;
+}
+
+static CMAudioFormatDescriptionRef mpv_apple_eac3_format(const struct mpv_apple_eac3_packet *input)
+{
+    AVFormatContext *mux = NULL;
+    AVPacket *packet = NULL;
+    uint8_t *bytes = NULL;
+    CMAudioFormatDescriptionRef result = NULL;
+    if (avformat_alloc_output_context2(&mux, NULL, "mp4", NULL) < 0 || !mux)
+        goto done;
+    AVStream *stream = avformat_new_stream(mux, NULL);
+    if (!stream || avio_open_dyn_buf(&mux->pb) < 0)
+        goto done;
+    stream->time_base = (AVRational){1, input->sample_rate};
+    stream->codecpar->codec_type = AVMEDIA_TYPE_AUDIO;
+    stream->codecpar->codec_id = AV_CODEC_ID_EAC3;
+    stream->codecpar->sample_rate = input->sample_rate;
+    stream->codecpar->frame_size = 1536;
+    av_channel_layout_default(&stream->codecpar->ch_layout, input->channels);
+    if (avformat_write_header(mux, NULL) < 0)
+        goto done;
+    packet = av_packet_alloc();
+    if (!packet)
+        goto done;
+    int64_t pts = 0;
+    for (int i = 0; i < input->packet_count; i++) {
+        AudioStreamPacketDescription description = input->packets[i];
+        if (av_new_packet(packet, description.mDataByteSize) < 0)
+            goto done;
+        memcpy(packet->data, input->data + description.mStartOffset, description.mDataByteSize);
+        packet->pts = packet->dts = pts;
+        packet->duration = description.mVariableFramesInPacket;
+        packet->stream_index = 0;
+        pts += packet->duration;
+        if (av_write_frame(mux, packet) < 0)
+            goto done;
+        av_packet_unref(packet);
+    }
+    if (av_write_trailer(mux) < 0)
+        goto done;
+    int length = avio_close_dyn_buf(mux->pb, &bytes);
+    mux->pb = NULL;
+    if (length < 12 || length > 262144)
+        goto done;
+    size_t cookie_size = 0;
+    const uint8_t *cookie = mpv_apple_eac3_cookie(bytes, length, 0, &cookie_size);
+    if (cookie) {
+        AudioStreamBasicDescription asbd = {
+            .mSampleRate = input->sample_rate,
+            .mFormatID = kAudioFormatEnhancedAC3,
+            .mFramesPerPacket = 0,
+            .mChannelsPerFrame = input->channels,
+        };
+        OSStatus status = CMAudioFormatDescriptionCreate(kCFAllocatorDefault, &asbd,
+            0, NULL, cookie_size, cookie, NULL, &result);
+        if (status != noErr)
+            result = NULL;
+    }
+done:
+    av_packet_free(&packet);
+    if (mux && mux->pb) {
+        avio_close_dyn_buf(mux->pb, &bytes);
+        mux->pb = NULL;
+    }
+    av_free(bytes);
+    avformat_free_context(mux);
+    return result;
+}
