+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <CoreGraphics/CoreGraphics.h>
+#include <QuartzCore/CAMetalLayer.h>
+#include <MoltenVK/mvk_vulkan.h>
+#include <math.h>
+
+#include "common.h"
+#include "context.h"
+#include "utils.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+    CAMetalLayer *layer;
+    int last_width;
+    int last_height;
+    bool has_reconfigured;
+};
+
+static bool moltenvk_drawable_size(struct priv *p, int *width, int *height)
+{
+    if (!p->layer)
+        return false;
+
+    CGSize size = p->layer.drawableSize;
+    if (!isfinite(size.width) || !isfinite(size.height) ||
+        size.width <= 1.0 || size.height <= 1.0)
+        return false;
+
+    *width = MPMAX(2, (int)llround(size.width));
+    *height = MPMAX(2, (int)llround(size.height));
+    return true;
+}
+
+static bool moltenvk_resize(struct ra_ctx *ctx, int width, int height,
+                            const char *reason)
+{
+    struct priv *p = ctx->priv;
+    CGColorSpaceRef previous_color_space = p->layer.colorspace;
+    if (previous_color_space)
+        CFRetain(previous_color_space);
+
+    // `ra_vk_ctx_resize` writes vo->dwidth/dheight from the actual extent
+    // returned by pl_swapchain_resize. Do not overwrite those values with
+    // the requested drawable size: the Vulkan surface may clamp its extent.
+    bool ok = ra_vk_ctx_resize(ctx, width, height);
+    if (previous_color_space) {
+        p->layer.colorspace = previous_color_space;
+        CFRelease(previous_color_space);
+    }
+    if (!ok) {
+        MP_WARN(ctx, "surface resize requested=%dx%d failed reason=%s; will retry\n",
+                width, height, reason ? reason : "unknown");
+        return false;
+    }
+
+    // Cache the requested CAMetalLayer extent, not vo->dwidth/dheight, so
+    // an implementation-selected swapchain extent does not cause every
+    // VOCTRL_CHECK_EVENTS poll to request the same resize again.
+    p->last_width = width;
+    p->last_height = height;
+    MP_VERBOSE(ctx, "surface resize requested=%dx%d applied=%dx%d reason=%s\n",
+               width, height, ctx->vo->dwidth, ctx->vo->dheight,
+               reason ? reason : "unknown");
+    return true;
+}
+
+static void moltenvk_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+}
+
+static bool moltenvk_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    if (ctx->vo->opts->WinID == -1) {
+        MP_MSG(ctx, msgl, "WinID missing\n");
+        goto fail;
+    }
+
+    if (!mpvk_init(vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME))
+        goto fail;
+
+    p->layer = (__bridge CAMetalLayer *)(intptr_t)ctx->vo->opts->WinID;
+    VkMetalSurfaceCreateInfoEXT info = {
+         .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+         .pLayer = p->layer,
+    };
+
+    struct ra_ctx_params params = {0};
+
+    VkInstance inst = vk->vkinst->instance;
+    VkResult res = vkCreateMetalSurfaceEXT(inst, &info, NULL, &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_MSG(ctx, msgl, "Failed creating MoltenVK surface\n");
+        goto fail;
+    }
+
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
+        goto fail;
+
+    return true;
+fail:
+    moltenvk_uninit(ctx);
+    return false;
+}
+
+static bool moltenvk_reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    int width, height;
+
+    // VOCTRL_CHECK_EVENTS can run after context initialization but before
+    // the first video reconfig. Mark that boundary so event polling cannot
+    // create a swapchain and then have this path immediately recreate it.
+    p->has_reconfigured = true;
+    if (!moltenvk_drawable_size(p, &width, &height)) {
+        MP_VERBOSE(ctx, "deferring surface resize until drawable is valid\n");
+        return true;
+    }
+
+    return moltenvk_resize(ctx, width, height, "reconfig");
+}
+
+static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    struct priv *p = ctx->priv;
+
+    if (request == VOCTRL_CHECK_EVENTS && p->layer) {
+        // The vulkan swapchain does not auto-track the CAMetalLayer's
+        // drawableSize; mpv only learns about a surface size change when we
+        // report it here. gpu-next deliberately makes gpu_ctx_resize() a
+        // no-op for Vulkan because the platform RA context owns resizing, so
+        // emitting VO_EVENT_RESIZE alone leaves the swapchain at its old
+        // extent. Resize directly once, then emit the event so gpu-next
+        // recomputes its source/destination rectangles and redraws.
+        int width, height;
+        if (p->has_reconfigured &&
+            moltenvk_drawable_size(p, &width, &height) &&
+            (width != p->last_width || height != p->last_height) &&
+            moltenvk_resize(ctx, width, height, "drawable-change")) {
+            *events |= VO_EVENT_RESIZE | VO_EVENT_EXPOSE;
+        }
+        return VO_TRUE;
+    }
+
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_moltenvk = {
+    .type           = "vulkan",
+    .name           = "moltenvk",
+    .reconfig       = moltenvk_reconfig,
+    .control        = moltenvk_control,
+    .init           = moltenvk_init,
+    .uninit         = moltenvk_uninit,
+};
