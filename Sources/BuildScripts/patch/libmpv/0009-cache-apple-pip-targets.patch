+static void apple_pip_release_cached_target_locked(
+    struct apple_pip_state *state,
+    struct apple_pip_target_cache_entry *entry)
+{
+    if (!entry)
+        return;
+    entry->in_use = false;
+    entry->last_used = ++state->cache_clock;
+    mp_cond_broadcast(&state->wakeup);
+}
