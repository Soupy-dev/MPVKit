+    if (entry->metal_target)
+        apple_pip_metal_target_destroy(&entry->metal_target);
+    if (entry->surface)
+        CFRelease(entry->surface);
+    memset(entry, 0, sizeof(*entry));
+}
+
+static bool apple_pip_has_cache_work_locked(struct apple_pip_state *state)
+{
