+            slot = &state->slots[i];
+            break;
+        }
+    }
+    if (slot) {
+        *slot = (struct apple_pip_slot) {
+            .state = APPLE_PIP_SLOT_IN_FLIGHT,
+            .token = 0,
+            .generation = state->generation,
+            .pts = p->last_pts,
+            .completion_status = MPV_APPLE_PIP_FRAME_READY,
+            .owner = state,
+        };
+        state->inline_probe_armed = false;
+        mp_cond_broadcast(&state->wakeup);
+    }
+    mp_mutex_unlock(&state->lock);
+}
