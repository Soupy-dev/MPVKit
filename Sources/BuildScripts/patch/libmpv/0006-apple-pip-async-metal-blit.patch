+static void apple_pip_metal_blit_complete(void *opaque, bool success)
+{
+    struct apple_pip_slot *slot = opaque;
+    struct apple_pip_state *state = slot->owner;
+    if (!state)
+        return;
+
+    mp_mutex_lock(&state->lock);
+    if (slot->state == APPLE_PIP_SLOT_IN_FLIGHT &&
+        slot->metal_blit_started) {
+        slot->metal_blit_succeeded = success;
+        slot->metal_blit_complete = true;
+        mp_cond_broadcast(&state->wakeup);
+    }
+    mp_mutex_unlock(&state->lock);
+}
+
+static void apple_pip_signal_inline_presented(struct priv *p)
+{
+    struct apple_pip_state *state = &p->apple_pip;
