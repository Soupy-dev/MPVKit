diff --git a/video/out/apple_pip_metal.m b/video/out/apple_pip_metal.m
new file mode 100644
index 0000000000000000000000000000000000000000..df9535524ccdd379f082b5b70d793db28ca3b7bc
--- /dev/null
+++ b/video/out/apple_pip_metal.m
@@ -0,0 +1,220 @@
+/*
+ * Copyright (C) 2026 MPVKit contributors
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#import <Metal/Metal.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "apple_pip_metal.h"
+
+struct apple_pip_metal_context {
+    void *device;
+    void *queue;
+};
+
+struct apple_pip_metal_target {
+    void *source;
+    void *destination;
+};
+
+static void *retain_object(id object)
+{
+    if (!object)
+        return NULL;
+#if __has_feature(objc_arc)
+    return (__bridge_retained void *)object;
+#else
+    return [object retain];
+#endif
+}
+
+static id object_from_pointer(void *pointer)
+{
+    return (__bridge id)pointer;
+}
+
+static void release_object(void *pointer)
+{
+    if (!pointer)
+        return;
+#if __has_feature(objc_arc)
+    id value = (__bridge_transfer id)pointer;
+    (void)value;
+#else
+    [(id)pointer release];
+#endif
+}
+
+struct apple_pip_metal_context *apple_pip_metal_create(
+    char *diagnostic, size_t diagnostic_size)
+{
+    @autoreleasepool {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        if (!device || !queue) {
+#if !__has_feature(objc_arc)
+            [queue release];
+            [device release];
+#endif
+            snprintf(diagnostic, diagnostic_size,
+                     "Metal device or command queue is unavailable");
+            return NULL;
+        }
+
+        struct apple_pip_metal_context *context = calloc(1, sizeof(*context));
+        if (!context) {
+#if !__has_feature(objc_arc)
+            [queue release];
+            [device release];
+#endif
+            snprintf(diagnostic, diagnostic_size,
+                     "allocating Metal PiP context failed");
+            return NULL;
+        }
+        context->device = retain_object(device);
+        context->queue = retain_object(queue);
+#if !__has_feature(objc_arc)
+        [queue release];
+        [device release];
+#endif
+        snprintf(diagnostic, diagnostic_size,
+                 "asynchronous Metal blit output ready");
+        return context;
+    }
+}
+
+void apple_pip_metal_destroy(struct apple_pip_metal_context **context_ptr)
+{
+    if (!context_ptr || !*context_ptr)
+        return;
+    struct apple_pip_metal_context *context = *context_ptr;
+    release_object(context->queue);
+    release_object(context->device);
+    free(context);
+    *context_ptr = NULL;
+}
+
+struct apple_pip_metal_target *apple_pip_metal_target_create(
+    struct apple_pip_metal_context *context, IOSurfaceRef destination_surface,
+    uint32_t width, uint32_t height, char *diagnostic,
+    size_t diagnostic_size)
+{
+    if (!context || !destination_surface || !width || !height)
+        return NULL;
+
+    @autoreleasepool {
+        id<MTLDevice> device = object_from_pointer(context->device);
+        MTLTextureDescriptor *source_descriptor =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                               width:width
+                                                              height:height
+                                                           mipmapped:NO];
+        source_descriptor.storageMode = MTLStorageModePrivate;
+        source_descriptor.usage = MTLTextureUsageRenderTarget |
+                                  MTLTextureUsageShaderRead;
+        id<MTLTexture> source = [device newTextureWithDescriptor:source_descriptor];
+
+        MTLTextureDescriptor *destination_descriptor =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                               width:width
+                                                              height:height
+                                                           mipmapped:NO];
+        destination_descriptor.storageMode = MTLStorageModeShared;
+        destination_descriptor.usage = MTLTextureUsageShaderRead;
+        id<MTLTexture> destination =
+            [device newTextureWithDescriptor:destination_descriptor
+                                   iosurface:destination_surface
+                                       plane:0];
+        if (!source || !destination) {
+#if !__has_feature(objc_arc)
+            [destination release];
+            [source release];
+#endif
+            snprintf(diagnostic, diagnostic_size,
+                     "creating Metal source or IOSurface destination texture failed");
+            return NULL;
+        }
+
+        source.label = @"MPVKit PiP Vulkan render target";
+        destination.label = @"MPVKit PiP IOSurface blit destination";
+        struct apple_pip_metal_target *target = calloc(1, sizeof(*target));
+        if (!target) {
+#if !__has_feature(objc_arc)
+            [destination release];
+            [source release];
+#endif
+            snprintf(diagnostic, diagnostic_size,
+                     "allocating Metal PiP target failed");
+            return NULL;
+        }
+        target->source = retain_object(source);
+        target->destination = retain_object(destination);
+#if !__has_feature(objc_arc)
+        [destination release];
+        [source release];
+#endif
+        return target;
+    }
+}
+
+void *apple_pip_metal_target_source_texture(
+    struct apple_pip_metal_target *target)
+{
+    return target ? target->source : NULL;
+}
+
+bool apple_pip_metal_target_blit(
+    struct apple_pip_metal_context *context,
+    struct apple_pip_metal_target *target,
+    apple_pip_metal_completion completion, void *opaque)
+{
+    if (!context || !target || !completion)
+        return false;
+
+    @autoreleasepool {
+        id<MTLCommandQueue> queue = object_from_pointer(context->queue);
+        id<MTLTexture> source = object_from_pointer(target->source);
+        id<MTLTexture> destination = object_from_pointer(target->destination);
+        id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
+        id<MTLBlitCommandEncoder> encoder = [command_buffer blitCommandEncoder];
+        if (!command_buffer || !encoder)
+            return false;
+
+        MTLSize size = MTLSizeMake(source.width, source.height, 1);
+        [encoder copyFromTexture:source
+                    sourceSlice:0
+                    sourceLevel:0
+                   sourceOrigin:MTLOriginMake(0, 0, 0)
+                     sourceSize:size
+                      toTexture:destination
+               destinationSlice:0
+               destinationLevel:0
+              destinationOrigin:MTLOriginMake(0, 0, 0)];
+        [encoder endEncoding];
+        [command_buffer addCompletedHandler:^(id<MTLCommandBuffer> buffer) {
+            completion(opaque, buffer.status == MTLCommandBufferStatusCompleted);
+        }];
+        [command_buffer commit];
+        return true;
+    }
+}
+
+void apple_pip_metal_target_destroy(struct apple_pip_metal_target **target_ptr)
+{
+    if (!target_ptr || !*target_ptr)
+        return;
+    struct apple_pip_metal_target *target = *target_ptr;
+    release_object(target->destination);
+    release_object(target->source);
+    free(target);
+    *target_ptr = NULL;
+}
