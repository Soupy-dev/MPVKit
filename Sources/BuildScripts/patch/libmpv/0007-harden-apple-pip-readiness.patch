+static void apple_pip_requeue_target(struct priv *p,
+                                     struct apple_pip_slot *slot)
+{
+    if (!slot)
+        return;
+
+    struct apple_pip_state *state = &p->apple_pip;
+    mp_mutex_lock(&state->lock);
+    if (slot->state == APPLE_PIP_SLOT_RENDERING &&
+        slot->generation == state->generation &&
+        slot->completion_status == MPV_APPLE_PIP_FRAME_READY) {
+        // No decoded frame is available yet. Keep the target for the next
+        // natural VO draw; deliberately do not re-arm a forced redraw loop.
+        slot->state = APPLE_PIP_SLOT_QUEUED;
+    } else if (slot->state == APPLE_PIP_SLOT_RENDERING) {
+        slot->state = APPLE_PIP_SLOT_CANCELED;
+    }
+    mp_cond_broadcast(&state->wakeup);
+    mp_mutex_unlock(&state->lock);
+}
