 #import <AudioToolbox/AudioToolbox.h>
@@ -33,8 +37,58 @@
 struct priv {
     AudioUnit audio_unit;
     double device_latency;
+    atomic_bool reload_requested;
 };

+static atomic_uint_fast64_t audiounit_recovery_count;
+
+// Optional diagnostics ABI used by MPVKit. Keep this in the AudioUnit driver's object file so
+// static Apple builds that include the driver also retain the counter without touching mpv's
+// public client ABI.
+__attribute__((visibility("default"), used, retain))
+uint64_t mpv_apple_audiounit_recovery_count(void)
+{
+    return atomic_load_explicit(&audiounit_recovery_count, memory_order_relaxed);
+}
+
+static void silence_buffers(struct ao *ao, AudioBufferList *buffer_list)
+{
+    if (!buffer_list)
+        return;
+
+    UInt32 buffer_count = buffer_list->mNumberBuffers;
+    if (buffer_count > (UInt32)MP_NUM_CHANNELS)
+        buffer_count = (UInt32)MP_NUM_CHANNELS;
+
+    for (UInt32 n = 0; n < buffer_count; n++) {
+        AudioBuffer *buffer = &buffer_list->mBuffers[n];
+        if (!buffer->mData || !buffer->mDataByteSize)
+            continue;
+        if (ao)
+            af_fill_silence(buffer->mData, buffer->mDataByteSize, ao->format);
+        else
+            memset(buffer->mData, 0, buffer->mDataByteSize);
+    }
+}
+
+static bool validate_render_buffers(struct ao *ao, const AudioTimeStamp *ts,
+                                    AudioBufferList *buffer_list, UInt32 frames)
+{
+    if (!ao || !ao->priv || !ts || !buffer_list || ao->num_planes <= 0 ||
+        ao->num_planes > MP_NUM_CHANNELS ||
+        buffer_list->mNumberBuffers < (UInt32)ao->num_planes ||
+        ao->sstride <= 0 || frames > UINT32_MAX / (UInt32)ao->sstride)
+        return false;
+
+    UInt32 needed = frames * (UInt32)ao->sstride;
+    for (int n = 0; n < ao->num_planes; n++) {
+        AudioBuffer *buffer = &buffer_list->mBuffers[n];
+        if (!buffer->mData || buffer->mDataByteSize < needed)
+            return false;
+    }
+    return true;
+}
+
 static OSStatus au_get_ary(AudioUnit unit, AudioUnitPropertyID inID, AudioUnitScope inScope, AudioUnitElement inElement, void **data, UInt32 *outDataSize)
 {
     OSStatus err;
@@ -88,9 +138,33 @@ static OSStatus render_cb_lpcm(void *ctx, AudioUnitRenderActionFlags *aflags,
