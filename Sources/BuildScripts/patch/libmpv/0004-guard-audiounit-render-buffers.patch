-    struct priv *p = ao->priv;
     void *planes[MP_NUM_CHANNELS] = {0};

+    // A zero-frame render is a benign no-op and must not trigger a reload.
+    if (frames == 0)
+        return noErr;
+
+    if (!validate_render_buffers(ao, ts, buffer_list, frames)) {
+        if (aflags)
+            *aflags |= kAudioUnitRenderAction_OutputIsSilence;
+        silence_buffers(ao, buffer_list);
+
+        if (ao && ao->priv) {
+            struct priv *p = ao->priv;
+            bool expected = false;
+            if (atomic_compare_exchange_strong_explicit(&p->reload_requested,
+                                                        &expected, true,
+                                                        memory_order_relaxed,
+                                                        memory_order_relaxed)) {
+                atomic_fetch_add_explicit(&audiounit_recovery_count, 1, memory_order_relaxed);
+                ao_request_reload(ao);
+            }
+        }
+        return noErr;
+    }
+
+    struct priv *p = ao->priv;
+
     for (int n = 0; n < ao->num_planes; n++)
         planes[n] = buffer_list->mBuffers[n].mData;

