+bool vk_flush_queued(struct vk_ctx *vk)
+{
+    if (!vk->defer_cmd_submits)
+        return true;
+
+    pl_mutex_lock(&vk->flush_lock);
+    pl_mutex_lock(&vk->lock);
+    int num = vk->cmds_queued.num;
+    if (!num) {
+        pl_mutex_unlock(&vk->lock);
+        pl_mutex_unlock(&vk->flush_lock);
+        return true;
+    }
+
+    void *tmp = pl_tmp(NULL);
+    struct vk_cmd **cmds = pl_calloc_ptr(tmp, num, cmds);
+    memcpy(cmds, vk->cmds_queued.elem, num * sizeof(*cmds));
+    vk->cmds_queued.num = 0;
+    pl_mutex_unlock(&vk->lock);
+
+    bool ok = true;
+    int start = 0;
+    for (int i = 1; i <= num; i++) {
+        if (i == num || cmds[i]->queue != cmds[start]->queue) {
+            ok &= vk_cmd_submit_batch(vk, &cmds[start], i - start);
+            start = i;
+        }
+    }
+
+    pl_free(tmp);
+    pl_mutex_unlock(&vk->flush_lock);
+    return ok;
