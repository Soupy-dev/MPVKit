<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MpvKitRuntimeDirectory Condition="'$(MpvKitRuntimeDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\dist\windows-x64</MpvKitRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MPVKit.Windows\MPVKit.Windows.csproj" />
  </ItemGroup>
  <Import Project="..\MPVKit.Windows\buildTransitive\MPVKit.Windows.targets" />
</Project>
